[Unit]
Description=solo-pool-rs — solo Bitcoin mining pool
Documentation=https://github.com/cbyam/solo-pool-rs
# Start after the network is up AND after your Bitcoin node. If bitcoind runs
# under systemd (recommended), order against it so the pool starts after the
# node. Rename "bitcoind.service" if your node unit is named differently, or
# drop these two tokens if bitcoind is managed outside systemd.
After=network-online.target bitcoind.service
Wants=network-online.target bitcoind.service

# Cap restart storms. NOTE: these belong in [Unit], not [Service] — systemd
# silently ignores them if placed under [Service].
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/bin/solo-pool-rs /etc/solo-pool-rs/config.toml
Restart=on-failure
RestartSec=5

# ── Wait until bitcoind's RPC is actually ready ───────────────────────────────
# Ordering (After=bitcoind.service) is necessary but NOT sufficient: a
# Type=simple bitcoind is considered "started" the instant its process forks,
# while the RPC still returns -28 ("Verifying blocks…/Loading…") for some time.
# Starting the pool then makes getblocktemplate fail and can exit it on a
# transient error. Block here until the RPC answers a real call.
#
# Uncomment and adjust the cookie path / port for your node. Then raise
# TimeoutStartSec so the probe has room (default start timeout is 90s).
# -datadir is set to an accessible dir so bitcoin-cli does not try to read its
# default ~/.bitcoin (ProtectHome above blocks it, and bitcoin-cli aborts on the
# permission error before it ever makes the RPC call).
#   ExecStartPre=/bin/sh -c 'for i in $(seq 1 150); do \
#     /usr/local/bin/bitcoin-cli -datadir=/var/lib/solo-pool-rs \
#       -rpcconnect=127.0.0.1 -rpcport=8332 \
#       -rpccookiefile=/var/lib/bitcoind/.cookie getblockchaininfo >/dev/null 2>&1 \
#     && exit 0; sleep 2; done; \
#     echo "bitcoind RPC not ready after 300s" >&2; exit 1'
#   TimeoutStartSec=330

# Dedicated unprivileged user (create it once — see README).
User=solo-pool
Group=solo-pool

# systemd creates and owns /var/lib/solo-pool-rs for you. Point the SQLite
# stats DB there:  stats_db_path = "/var/lib/solo-pool-rs/pool_stats.sqlite"
# The SV2 authority key needs a writable path too. Its default
# ("sv2-authority.key") resolves against the working directory, which is
# read-only under ProtectSystem=strict below, and the pool fails at boot if it
# cannot create the key. In config.toml set:
#   authority_key_file = "/var/lib/solo-pool-rs/sv2-authority.key"
# (or set persist_authority_key = false to keep an ephemeral per-process key).
StateDirectory=solo-pool-rs

# Logs go to the journal (journalctl -u solo-pool-rs) while log_dir is empty
# in config.toml. For files instead, set log_dir = "/var/log/solo-pool-rs":
# LogsDirectory= creates that directory owned by the service user, writable
# under ProtectSystem=strict, and removes it on uninstall. Retention is
# log_max_files in config.toml (default 14 days); no logrotate needed.
LogsDirectory=solo-pool-rs

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
# read-only (not true) so a Bitcoin cookie under a home dir stays readable.
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# The pool must READ bitcoind's RPC cookie. Either add `solo-pool` to the group
# that can read your node's data dir (bitcoind's own group, or a shared node
# group like `bitstack` covering CLN/electrum/etc.) and set rpccookieperms=group
# so the cookie is group-readable, or use explicit rpcuser/rpcpassword in
# config.toml instead of cookie auth. If your datadir is outside any home
# directory, also grant read access here, e.g.:
#   ReadOnlyPaths=/srv/bitcoin/.cookie

[Install]
WantedBy=multi-user.target
