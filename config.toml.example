# solo-pool-rs configuration
# Copy this to config.toml and adjust for your environment.
#
#   cp config.toml.example config.toml
#   # edit coinbase_address and bitcoin_rpc settings, then:
#   cargo build --release
#   ./target/release/solo-pool-rs config.toml
#
# Every scalar value (string, number, boolean) can be overridden by an
# environment variable named SOLO_POOL_<SECTION>__<KEY> (double underscore
# between section and key), which suits container platforms that configure
# apps through env vars. Lists such as allowed_hosts cannot be overridden:
#
#   SOLO_POOL_POOL__COINBASE_ADDRESS=bc1q...     # [pool] coinbase_address
#   SOLO_POOL_BITCOIN_RPC__URL=http://10.0.0.5:8332
#   SOLO_POOL_SV2__ENABLED=false
#
# Overrides are parsed as the type the key has in this file. For keys absent
# from the file, true/false and numbers are typed as such — wrap the value in
# double quotes to force a string (e.g. an all-numeric RPC password).

[pool]
# Address and port miners connect to
listen_addr = "0.0.0.0:3333"

# Your Bitcoin address — ALL block rewards go here (solo = 100%)
coinbase_address = "bc1qyouraddresshere"

# Tag embedded in the coinbase scriptSig. The scriptSig is capped at 100 bytes
# including the height push and the extranonce, so 87 bytes are available at
# the default extranonce sizes; longer is refused at boot.
coinbase_tag = "/solo-pool-rs/"

# Optional safety assertion. The pool always detects the actual network from
# the connected node (getblockchaininfo) and refuses to build jobs unless the
# payout address is valid for that chain. Setting this additionally makes
# boot fail fast if the node reports a different chain — catching a config
# pointed at the wrong node. "mainnet" | "testnet" | "testnet4" | "signet" | "regtest".
# network = "mainnet"

# Initial share difficulty assigned to new miners.
# Vardiff will adjust from here. Setting it near the expected steady-state
# value for your hardware saves the first few retargets. Shares are accepted
# down to [vardiff] min_difficulty whatever this is, so a high value costs no
# rejects; a value far too low floods the pool with shares until the first
# retarget. Keep it at or above min_difficulty: it is not clamped.
#
# Rough guide (one share every 15 seconds, difficulty = H/s × 15 / 2^32):
#   500 GH/s  →  ~1 750      (USB stick, small Bitaxe)
#   1 TH/s    →  ~3 500      (Bitaxe Gamma)
#   10 TH/s   →  ~35 000
#   100 TH/s  →  ~350 000
#   500 TH/s  →  ~1 750 000  (current flagship ASIC)
# The default suits a mixed fleet: small devices come down and large ones go
# up within a few retargets.
initial_difficulty = 4096

# Extranonce1 length in bytes. Each connection gets its own prefix from a
# counter; 4 bytes allows about 4 billion connections before it wraps.
extranonce1_size = 4

# Extranonce2 size advertised to SV1 miners (bytes). The Avalon Nano needs 4.
#
# extranonce1_size + extranonce2_size is the TOTAL extranonce region reserved in
# the coinbase. SV2 devices carve their requested rolling extranonce out of this
# same total (prefix = total - granted), so the total must be >= any SV2 device's
# min_extranonce_size (a NerdQAxe++ asks for 8 → 4 + 4 = 8 works). Raise the
# total (e.g. extranonce1_size = 8) only if an SV2 OpenChannel is still rejected.
extranonce2_size = 4

# Maximum number of simultaneous miner connections
max_connections = 256

# Idle connection timeout (seconds) — disconnect miners that stop responding
idle_timeout_secs = 300

# Directory where the raw hex of every found block is archived, in parallel
# with submission and never delaying it, so a failed submitblock can be retried
# automatically or replayed
# by hand (`bitcoin-cli submitblock "$(cat <file>)"`). Relative paths resolve
# against the service working directory, like stats_db_path.
found_block_dir = "found-blocks"

[sv2]
# Accept Stratum V2 (Extended Channel, Noise-encrypted) connections on the SAME
# listen_addr as SV1. The protocol is auto-detected from the first byte of each
# connection, so no separate port is needed. Point an SV2-capable miner (e.g. a
# NerdQAxe++ on AxeOS >= v1.0.37, "Stratum V2" selected) at the same host:port
# as your SV1 miners.
#
# Set to false to refuse SV2 and serve SV1 only.
enabled = true

# Persist the Noise authority key so the pool keeps the same identity across
# restarts. The base58check public key is logged at startup and shown in the
# dashboard's Connect modal; set it as the pool/authority public key on the
# miner to cryptographically verify the pool (identity pinning). Miners that
# do not pin connect exactly as before. Set to false for a fresh key each
# start (pinning miners will then refuse to connect after every restart).
persist_authority_key = true

# Where the authority secret key lives (one base58check line, created with
# owner-only permissions on first start). Relative paths resolve against the
# service working directory, like stats_db_path. Supports ~ expansion.
authority_key_file = "sv2-authority.key"

# Validity window (seconds) of the certificate signed for each connection:
# valid_from = now, not_valid_after = now + cert_validity_secs. Miners that
# verify pool identity check this window against their own clock (SRI-based
# verifiers allow 10 s of drift), so short values expose device clock skew.
# Default: one year.
cert_validity_secs = 31536000

[bitcoin_rpc]
# Bitcoin RPC endpoint (core/knots)
url = "http://127.0.0.1:8332"

# Cookie-file authentication. The cookie is always tried first: this path,
# or ~/.bitcoin/.cookie if the key is omitted. Use an absolute path for a
# custom datadir or rpccookiefile=, or when the service user has no home.
cookie_path = "~/.bitcoin/.cookie"

# Explicit credentials, used only when no cookie can be read
# user = "rpcuser"
# password = "rpcpassword"

# RPC timeout (seconds). Values below 5 are raised to 5 with a warning.
timeout_secs = 10

[zmq]
# ZMQ endpoint for the node's hashblock notifications
# Enable in bitcoin.conf:  zmqpubhashblock=tcp://127.0.0.1:28332
hashblock_endpoint = "tcp://127.0.0.1:28332"

# Poll the chain tip over RPC as a safety net alongside ZMQ.
#
# This runs continuously rather than only after a ZMQ failure, because a ZMQ
# subscription cannot be proven live from this side: connect() succeeds even
# when nothing is listening (wrong port, node without -zmqpubhashblock,
# firewall) and the socket then stays silent forever. The poll only signals
# when the tip hash actually changes, so with healthy ZMQ it costs one
# getbestblockhash per interval and changes nothing else.
#
# Leave this on. With it off, a silently dead subscription means new blocks
# are only noticed by the periodic template refresh.
poll_fallback = true
poll_interval_ms = 1000

[vardiff]
# Target number of seconds between share submissions per miner
target_share_time_secs = 15

# How often (seconds) each miner is re-judged. Runs on a timer, so a miner
# that sends no shares is still retargeted. Each judgement looks at the work
# proved over the last 20 target share times (5 minutes at 15 s), or one
# interval if that is longer.
retarget_interval_secs = 60

# Floor and ceiling on per-miner difficulty. The defaults span a ~10 GH/s
# USB stick to ~1.2 PH/s on one connection (the largest single machines, or
# a farm behind a proxy). Vardiff is per connection, so a wide range costs
# nothing: each miner settles at its own rate. Raise the ceiling for a proxy
# carrying more than ~1.2 PH/s.
#
# Below about 150 GH/s a miner sits at the floor and submits more slowly than
# the target. Keep that interval under [pool] idle_timeout_secs or the miner is
# disconnected between shares; at 512 it holds down to about 10 GH/s. Lower
# the floor (or raise the timeout) for anything slower.
#
# Shares are accepted down to the floor on every connection, whatever the
# assigned difficulty, because cgminer/Avalon firmware fixes its submission
# threshold at connect (from the minimum-difficulty in the mining.configure
# reply) and ignores later set_difficulty. Each share is credited at the
# difficulty it actually cleared, so a low floor does not distort hashrate.
min_difficulty = 512
max_difficulty = 4194304

# Cap on one retarget step (e.g. 4 = up to 4× change). Inside that cap the
# difficulty holds while the observed rate is within 1.5× of target, moves by
# the square root of the ratio within 3×, and by the full ratio beyond that.
max_retarget_factor = 4.0

[security]
# Rate-limit: max new TCP connections per IP per minute. Count every device
# that shares one address (a proxy, a rack behind NAT) and add headroom for a
# power-cycle reconnect burst. 5 suits one or two devices per address; raise
# it to 8 or more for a rack behind one address. Exceeding it refuses the
# connection; it never bans.
max_connections_per_ip = 5

# Max inbound messages per second per connection (token bucket). Exceeding it
# disconnects the session; it never bans. There is no "disabled" value: 0
# rejects every message.
max_shares_per_sec = 500

# How long (seconds) an address stays banned after an unambiguous protocol
# violation: an oversize SV1 line or SV2 frame, which no honest firmware
# sends. Rate-limit violations (connections per minute, messages per second)
# are refused or disconnected but never banned, because honest firmware trips
# them when it reconnects after a pool restart. Keep this short; the ban only
# saves the cost of repeated reconnects. 0 disables bans entirely.
ban_duration_secs = 300

# Maximum genuinely invalid shares before disconnect (0 = disabled). Counted:
# bad nonce, duplicate, out-of-range ntime, wrong extranonce length, and on SV2
# a submit for an unknown job. Low-difficulty shares and SV1 stale-job submits
# are not counted, since they are expected around block changes.
max_invalid_shares = 5

# Maximum SV1 line / SV2 message size (bytes). SV2 frames get 1024 extra bytes
# for framing and encryption overhead. Exceeding it disconnects and bans the
# address for ban_duration_secs.
max_message_bytes = 4096

# Maximum byte length of an accepted worker/user-identity name. Bounds the
# global per-worker stats maps and Prometheus label cardinality against
# untrusted names. 128 fits a bech32m payout address plus a `.worker` suffix.
max_worker_name_len = 128

# Maximum number of times one connection may switch to a new worker identity
# (SV1 mining.authorize / SV2 OpenExtendedMiningChannel). Re-authorizing the
# current name does not count; switching back to an earlier name does. Each
# new name creates per-worker stats entries and Prometheus label series, so
# this bounds how much a single connection can grow them. Real miners
# authorize once.
# 0 = disabled.
max_authorizations_per_session = 8

[metrics]
# HTTP address for the dashboard, its Settings page, and Prometheus /metrics.
# An empty string disables all of them.
prometheus_addr = "0.0.0.0:9090"

# Optional SQLite file for state that must survive restarts: all-time best
# share and hashrate, every block found and the running round, six months of
# hashrate history, the last 24 hours of accepted shares per worker (to restore
# the 3h/24h hashrate windows), and the payout address saved from the dashboard
# (which then wins over coinbase_address above). Leave empty or omit to
# disable.
stats_db_path = "pool_stats.sqlite"

# Allow changing the payout address from the dashboard Settings page (the
# network is read from the node and cannot be changed). The dashboard has no
# authentication of its own: on an untrusted LAN either set this to false or front the dashboard with an authenticating
# proxy (Umbrel's app_proxy does this automatically).
allow_runtime_settings = true

# Extra hostnames accepted on the mutating dashboard routes (POST /api/settings
# and POST /api/reset-best-hashrate). Those routes refuse any Host header that
# public DNS could have produced, which stops a web page from re-pointing its
# own domain at the pool's LAN address and changing the payout address from
# inside the browser (DNS rebinding). IP addresses, localhost, single-label
# names and local-only suffixes (.local, .lan, .home.arpa, .internal, ...) are
# always accepted. List anything else the dashboard is reached by, such as a
# Tailscale name or a split-horizon DNS name. Read-only routes are unaffected.
allowed_hosts = []

[logging]
# Log level: trace | debug | info | warn | error
level = "info"

# Emit structured JSON logs (useful for log aggregators like Loki)
json = false

# Optional: directory to write log files to. Leave empty or omit to log to
# stdout, which the journal, `docker logs` and Umbrel all capture; that is the
# right choice for every packaged install. Set it only when you want files.
# One file per day, named solo-pool-rs.log.YYYY-MM-DD. Supports ~ expansion.
# Under the systemd unit, use "/var/log/solo-pool-rs" (the unit's
# LogsDirectory= creates it with the right owner).
log_dir = ""

# How many daily files to keep when log_dir is set; the oldest is deleted when
# a new day's file opens. Ignored when log_dir is empty.
log_max_files = 14
